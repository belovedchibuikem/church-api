APP_NAME="Family House Connect API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
PUBLIC_CATALOGUE_RATE_LIMIT_PER_MINUTE=90
CERTIFICATE_VERIFICATION_RATE_LIMIT_PER_MINUTE=15
HOME_CHURCH_APPLICATION_RATE_LIMIT_PER_MINUTE=5
HOME_CHURCH_APPLICATION_RATE_LIMIT_PER_CONTACT_PER_HOUR=10
BROWSER_CSRF_RATE_LIMIT_PER_MINUTE=60
BROWSER_REGISTRATION_RATE_LIMIT_PER_HOUR=5
BROWSER_LOGIN_RATE_LIMIT_PER_MINUTE=5
BROWSER_VERIFICATION_RATE_LIMIT_PER_MINUTE=6
BROWSER_PASSWORD_RECOVERY_RATE_LIMIT_PER_MINUTE=5
ADMIN_STORAGE_RATE_LIMIT_PER_HOUR=10
BROWSER_PASSWORD_RESET_URL=http://localhost:3000/reset-password
MOBILE_ACCESS_TTL_SECONDS=3600
MOBILE_REFRESH_TTL_SECONDS=2592000
MOBILE_LOGIN_RATE_LIMIT_PER_MINUTE=5
MOBILE_LOGIN_RATE_LIMIT_PER_EMAIL_PER_MINUTE=5
MOBILE_REFRESH_RATE_LIMIT_PER_MINUTE=10
MFA_RECENT_SECONDS=43200
MFA_SETUP_RATE_LIMIT_PER_HOUR=5
MFA_CHALLENGE_RATE_LIMIT_PER_MINUTE=5

# Optional: default email for `php artisan authorization:bootstrap`
SUPER_ADMIN_EMAIL=

# Payment governance / gateway (OD-009/010)
# deny | allow_local | allow_configured
PAYMENT_GOVERNANCE_MODE=allow_local
PAYMENT_ALLOWED_PURPOSES=giving,event_payment
PAYMENT_ALLOWED_CURRENCIES=NGN,USD,GBP
# none | local_manual
PAYMENT_GATEWAY=local_manual
PAYMENT_LOCAL_CHECKOUT_URL="${APP_URL}/giving/checkout"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_JSON_INCLUDE_STACKTRACES=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=family_house_connect
DB_USERNAME=root
DB_PASSWORD=
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=family_house_connect_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Browser SPA origins (comma-separated, no trailing slash). Required for cookie
# login from the web app. localhost and 127.0.0.1 are different sites — list both
# locally. In production list every HTTPS frontend origin that calls this API
# (Vercel production + any custom domain). Example:
# CORS_ALLOWED_ORIGINS=https://familyconnect-vert.vercel.app,https://www.example.org
# Optional extra regexes (comma-separated). Loopback ports for Flutter web / Vite
# are allowed by default via config/cors.php — redeploy API after changing CORS.
# CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cross-site browser auth (frontend on another host than the API, e.g. Vercel →
# this API) also needs Secure + SameSite=None or the session cookie is dropped:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none
#
# Recommended for the web app (Vercel): keep SESSION_SAME_SITE=lax and route browser
# traffic through the frontend same-origin `/api` proxy (see frontend nitro.config.ts).
# List every frontend origin in CORS_ALLOWED_ORIGINS for preflight/direct calls.
# Point APP_URL at the public API origin with no /public suffix, e.g.
# APP_URL=https://familyconnect.katakarra.com


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILE_ASSET_MAXIMUM_BYTES=26214400
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_RETENTION_HOURS=168
QUEUE_BATCH_RETENTION_HOURS=48
QUEUE_UNFINISHED_BATCH_RETENTION_HOURS=168
QUEUE_CANCELLED_BATCH_RETENTION_HOURS=168

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
